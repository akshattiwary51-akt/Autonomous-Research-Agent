# Required for live LLM-backed runs; leave empty for offline/fallback behavior.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Optional OpenAI-compatible endpoint. Leave empty for the default OpenAI endpoint.
OPENAI_BASE_URL=

# Optional Semantic Scholar API key.
SEMANTIC_SCHOLAR_API_KEY=

# Safety and run limits.
MAX_ITERATIONS=6
MAX_TOOL_CALLS=12
ZERO_YIELD_REFLECTION_THRESHOLD=2
MAX_REFLECTION_ATTEMPTS=2

# Networking.
REQUEST_TIMEOUT=15
MAX_RESULTS_PER_TOOL_CALL=5

# Optional PDF full-text retrieval.
ENABLE_FULLTEXT_FETCH=false
FULLTEXT_FETCH_TIMEOUT=30
FULLTEXT_MAX_CHARS=15000

# Human approval before tool calls.
ENABLE_HITL=false

# Checkpoint persistence.
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_PATH=./checkpoints.sqlite

# Logging.
LOG_LEVEL=INFO
