# === LLM Configuration ===
# Required. Used for the ReAct agent's reasoning + tool selection + synthesis.
OPENAI_API_KEY=

# Model name for all LLM calls (planner, agent reasoning, evidence eval, synthesis).
MODEL_NAME=gpt-4o-mini

# Optional. Point at any OpenAI-compatible endpoint instead of OpenAI itself
# — e.g. Groq (fast, free tier, no card required):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_NAME=llama-3.3-70b-versatile
#   OPENAI_API_KEY=<your Groq API key, starts with gsk_>
# or OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Leave blank to use OpenAI directly.
OPENAI_BASE_URL=

# === Academic API Configuration ===
# Optional. Semantic Scholar works without a key but with much stricter rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# === Agent Safety / Loop Prevention ===
# Hard ceiling on ReAct loop iterations (Reason->Act->Observe cycles).
MAX_ITERATIONS=6

# Hard ceiling on total tool invocations across the whole run
# (separate from MAX_ITERATIONS since one iteration could try multiple tools).
MAX_TOOL_CALLS=12

# Number of consecutive "zero useful evidence" observations before the
# reflection node forces a query/strategy change.
ZERO_YIELD_REFLECTION_THRESHOLD=2

# Maximum number of times the reflection node may fire in a single run
# before the router gives up and forces synthesis instead (cycle
# detection: prevents an endless reflect<->agent loop if the LLM keeps
# disregarding strategy-change guidance).
MAX_REFLECTION_ATTEMPTS=2

# === Networking ===
# Per-request timeout (seconds) for all external tool calls.
REQUEST_TIMEOUT=15

# Max results requested per tool call.
MAX_RESULTS_PER_TOOL_CALL=5

# === Full-text retrieval ===
# If true, the agent downloads and extracts text from each paper's PDF
# (when an open-access one is resolvable) and grounds evidence extraction
# in the full text instead of just the abstract. Off by default: it adds
# real latency (PDF download + parse per paper) and LLM cost (more text
# per call), so it's an explicit opt-in accuracy upgrade.
ENABLE_FULLTEXT_FETCH=false

# Timeout (seconds) for downloading a paper's PDF. PDFs are larger than
# JSON API responses, so this is intentionally more generous than
# REQUEST_TIMEOUT.
FULLTEXT_FETCH_TIMEOUT=30

# Rough character budget per paper's extracted full text passed to the
# LLM. Longer text is truncated (from the start of the paper) to control
# cost/latency; the report notes when a section was extracted from
# truncated full text.
FULLTEXT_MAX_CHARS=15000

# === Circuit breaker ===
# How long (seconds) a tool that just returned a 429 (rate limit) is
# excluded from the agent's options before being offered again. Keeps the
# agent from repeatedly picking a tool it just learned is throttled.
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# === Human-in-the-loop ===
# If true, the graph will pause (LangGraph interrupt) before large-scale/
# multi-tool fan-out steps, waiting for external approval to continue.
ENABLE_HITL=false

# === Checkpointing ===
# "memory" (default, dev only) or "sqlite" (persists across process restarts).
CHECKPOINT_BACKEND=memory
# Only used when CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=./checkpoints.sqlite

# === Logging ===
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
